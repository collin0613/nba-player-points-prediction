# Copy to .env and replace placeholders. Never commit .env.
# NBA Stats endpoints do not require an API key; Sportradar is not used.
SPORTSGAMEODDS_API_KEY=replace-with-your-sportsgameodds-key
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key

# Existing PostgreSQL database and login role (see README setup).
DB_NAME=ml_sports
DB_USER=nba_ml
DB_PASSWORD=replace-with-your-database-password
DB_HOST=localhost
DB_PORT=5432
